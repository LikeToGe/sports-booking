@import "../../tokens.wxss";
:host { display: block; flex: 1; min-width: 0; }
.time-wheel, .time-trigger { box-sizing: border-box; min-width: 0; }
.time-trigger { display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px; margin: 0; padding: 10px 12px; border: 1px solid var(--color-rule-strong); border-radius: var(--radius-control); background: var(--color-surface); color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.4; }
button::after { border: 0; }
.time-label { flex-shrink: 0; color: var(--color-muted); font-size: 12px; }
.time-value { flex: 1; font-variant-numeric: tabular-nums; }
.is-empty { color: var(--color-muted); }
.time-trigger image { width: 14px; height: 14px; flex-shrink: 0; }
.time-trigger[disabled] { background: var(--color-disabled-surface); color: var(--color-disabled-ink); }
.wheel-overlay { position: fixed; inset: 0; z-index: 1200; }
.wheel-backdrop { position: absolute; inset: 0; background: rgba(36,57,54,.32); animation: wheel-fade 180ms var(--ease-out) both; }
.wheel-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 16px calc(16px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; background: var(--color-surface); color: var(--color-ink); animation: wheel-enter 240ms var(--ease-out) both; }
.wheel-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 64px; border-bottom: 1px solid var(--color-rule); }
.wheel-toolbar button { min-width: 60px; min-height: 44px; margin: 0; padding: 0 8px; border: 0; background: transparent; font-size: 14px; font-weight: 600; line-height: 44px; }
.wheel-cancel { color: var(--color-muted); }
.wheel-confirm { color: var(--color-primary); }
.wheel-confirm[disabled] { color: var(--color-disabled-ink); }
.wheel-title { font-size: 16px; font-weight: 600; }
.wheel-caption { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 16px 8px 4px; color: var(--color-muted); font-size: 12px; }
.wheel-caption > text:first-child { color: var(--color-primary); font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.wheel-picker { height: 220px; }
.wheel-option { display: flex; align-items: center; justify-content: center; gap: 12px; height: 44px; font-size: 24px; font-weight: 500; font-variant-numeric: tabular-nums; }
.wheel-option text { color: var(--color-muted); font-size: 12px; }
.wheel-indicator { height: 44px; border-top: 1px solid var(--color-primary-soft); border-bottom: 1px solid var(--color-primary-soft); }
.wheel-mask { background-image: linear-gradient(180deg, var(--color-surface), rgba(255,255,255,0)), linear-gradient(0deg, var(--color-surface), rgba(255,255,255,0)); }
button:active { transform: scale(.97); }
button:focus-visible { outline: 2px solid var(--color-focus); }
@keyframes wheel-enter { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
@keyframes wheel-fade { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .wheel-backdrop, .wheel-sheet { animation: none; } button:active { transform: none; } }
