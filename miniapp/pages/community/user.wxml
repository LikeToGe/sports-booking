<operation-toast />
<view class="page user-page"><view wx:if="{{profile}}" class="screen-head"><image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" /><text class="screen-title">{{profile.nickname}}</text><view><text wx:for="{{profile.sports}}" wx:key="*this" class="sport">{{item}}</text></view></view><view wx:for="{{profile.posts}}" wx:key="id" class="user-post" data-id="{{item.id}}" bindtap="open"><text>{{item.sportName}}</text><text>{{item.body}}</text></view><view wx:if="{{profile && !profile.posts.length}}" class="empty">暂无公开动态</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
