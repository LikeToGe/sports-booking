<operation-toast />
<view class="page user-page"><view wx:if="{{profile}}" class="screen-head"><image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" /><text class="screen-title">{{profile.nickname}}</text><view><text wx:for="{{profile.sports}}" wx:key="*this" class="sport">{{item}}</text></view><button class="button-secondary" bindtap="reportUser">举报账号</button></view><view wx:for="{{profile.posts}}" wx:key="id" class="user-post surface" data-id="{{item.id}}" bindtap="open"><text>{{item.sportName}}</text><text>{{item.body}}</text><image wx:if="{{item.previewPath}}" class="user-preview" src="{{item.previewPath}}" mode="aspectFill" aria-label="球友动态图片" /><text wx:if="{{item.previewError}}" class="muted">图片暂不可用，可进入详情重试。</text></view><view wx:if="{{loading}}" class="empty" role="status">正在加载球友主页</view><view wx:if="{{profile && !profile.posts.length}}" class="empty">暂无公开动态</view><view wx:if="{{message}}" role="status">{{message}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
