<view class="page home-page">
  <view class="screen-head">
    <text class="screen-title">今天想打什么？</text>
    <text class="muted">郑州市 · 选择运动和日期</text>
  </view>

  <view class="search-panel surface">
    <view class="search-row">
      <view class="search-field"><input class="search-input" value="{{keyword}}" placeholder="搜索场馆名称" confirm-type="search" bindinput="onKeyword" bindconfirm="search" /></view>
    </view>
    <view class="filter-row">
      <view class="date-picker"><picker mode="date" value="{{date}}" bindchange="selectDate"><view class="date-button">{{dateLabel}}</view></picker></view>
      <scroll-view class="sport-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <button class="sport-chip {{!selectedSportId ? 'is-active' : ''}}" data-id="" bindtap="selectSport">全部</button>
        <button wx:for="{{sports}}" wx:key="id" class="sport-chip {{selectedSportId === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectSport">{{item.name}}</button>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="section-head"><text class="section-title">可预约场馆</text><text class="muted">{{venues.length}} 家</text></view>
  <view class="venue-list" aria-live="polite">
    <button wx:for="{{venues}}" wx:key="id" class="venue-card surface" data-id="{{item.id}}" bindtap="openVenue">
      <image class="venue-cover" src="{{item.cover}}" mode="aspectFill" lazy-load="{{index > 1}}" aria-label="{{item.name}}场馆封面" />
      <view class="venue-copy">
        <view class="venue-title-line"><text class="venue-name">{{item.name}}</text><text class="price">{{item.price}}</text></view>
        <text class="venue-sports">{{item.sportNames}}</text>
        <text class="venue-address">{{item.address}}</text>
        <text class="next-time">{{item.nextTime}}</text>
      </view>
    </button>
  </view>
  <view wx:if="{{!loading && !venues.length}}" class="empty surface"><text class="empty-title">没有符合条件的场馆</text><text>更换运动类型或日期后再查看。</text></view>
</view>
