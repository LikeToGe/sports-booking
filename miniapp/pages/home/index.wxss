.home-page { display: grid; align-content: start; gap: 24rpx; }
.search-panel { display: grid; gap: 20rpx; padding: 20rpx; }
.search-row { display: block; }
.search-input, .date-button { height: 84rpx; border: 2rpx solid var(--rule); border-radius: 12rpx; background: var(--paper); }
.search-field { width: 100%; min-width: 0; }
.search-input { width: 100%; min-width: 0; padding: 0 22rpx; }
.filter-row { display: grid; grid-template-columns: 124rpx minmax(0, 1fr); align-items: center; gap: 12rpx; }
.date-picker { width: 124rpx; }
.date-button { display: flex; align-items: center; justify-content: center; width: 100%; padding: 0; font-variant-numeric: tabular-nums; }
.sport-strip { width: 100%; white-space: nowrap; }
.sport-chip { display: inline-flex; min-height: 64rpx; margin-right: 12rpx; padding: 0 22rpx; border: 2rpx solid var(--rule); background: var(--surface); color: var(--ink-2); line-height: 60rpx; }
.sport-chip.is-active { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
.venue-list { display: grid; gap: 20rpx; }
.venue-card { display: grid; grid-template-columns: 210rpx minmax(0, 1fr); gap: 20rpx; width: 100%; min-height: 188rpx; padding: 16rpx; color: var(--ink); text-align: left; line-height: 1.4; }
.venue-cover { width: 210rpx; height: 156rpx; border-radius: 12rpx; background: var(--paper-2); }
.venue-copy { display: grid; align-content: start; gap: 8rpx; min-width: 0; }
.venue-title-line { display: flex; align-items: start; justify-content: space-between; gap: 12rpx; }
.venue-name { min-width: 0; font-size: 31rpx; font-weight: 700; }
.venue-title-line .price { white-space: nowrap; }
.venue-sports, .venue-address { overflow: hidden; color: var(--muted); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.next-time { color: var(--accent-strong); font-size: 24rpx; font-weight: 600; }
