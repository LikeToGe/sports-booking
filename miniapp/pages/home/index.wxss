/* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 */
/* Hallmark · genre: modern-minimal · macrostructure: Narrative Workflow · design-system: design.md · designed-as-app */
.home-page { max-width: 640px; margin: 0 auto; padding: var(--space-sm) var(--space-sm) calc(var(--bottom-nav-height) + var(--space-xl) + env(safe-area-inset-bottom)); }
.home-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-bottom: var(--space-md); }
.home-title { min-width: 0; overflow-wrap: anywhere; font-family: var(--font-display); font-size: var(--text-xl); font-weight: var(--font-weight-bold); line-height: var(--line-tight); }
.home-location { display: flex; flex-shrink: 0; align-items: center; gap: var(--space-3xs); color: var(--color-ink-2); font-size: var(--text-sm); }
.icon-small { width: var(--space-sm); height: var(--space-sm); flex-shrink: 0; }
.search-bar { display: flex; align-items: center; gap: var(--space-2xs); padding: var(--space-3xs); border: var(--rule-hairline) solid var(--color-muted); border-radius: var(--radius-input); background: var(--color-surface); }
.search-icon { flex-shrink: 0; width: var(--space-md); height: var(--space-md); margin-left: var(--space-2xs); }
.search-input { flex: 1; min-width: 0; height: var(--touch-target); font-size: var(--text-base); }
.search-placeholder { color: var(--color-muted); }
.home-page .search-button { flex-shrink: 0; min-width: calc(var(--touch-target) + var(--space-sm)); min-height: var(--touch-target); padding: 0 var(--space-xs); border: 0; border-radius: var(--radius-md); background: var(--color-primary); color: var(--color-primary-ink); font-size: var(--text-sm); line-height: var(--touch-target); }
.search-button[disabled] { opacity: var(--opacity-disabled); }
.sport-strip { width: 100%; margin-top: var(--space-xs); }
.sport-options { display: inline-flex; gap: var(--space-2xs); min-width: 100%; padding-bottom: var(--space-3xs); }
.home-page .sport-chip { flex-shrink: 0; display: flex; align-items: center; min-height: var(--touch-target); padding: 0 var(--space-sm); border: var(--rule-hairline) solid transparent; border-radius: var(--radius-control); background: var(--color-surface); color: var(--color-ink-2); font-size: var(--text-sm); font-weight: var(--font-weight-medium); line-height: var(--line-base); }
.home-page .sport-chip.is-active { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-surface); font-weight: var(--font-weight-semibold); }
.results-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2xs); margin: var(--space-md) 0 var(--space-xs); }
.results-title { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2xs); min-width: 0; }
.home-page .section-title { font-size: var(--text-md); line-height: var(--line-tight); }
.result-count { color: var(--color-ink-2); font-size: var(--text-xs); white-space: nowrap; }
.results-heading picker { flex-shrink: 0; }
.date-button { display: flex; align-items: center; justify-content: center; gap: var(--space-2xs); min-height: var(--touch-target); padding: 0 var(--space-xs); border: var(--rule-hairline) solid var(--color-muted); border-radius: var(--radius-control); background: var(--color-surface); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
.date-chevron { width: var(--space-xs); height: var(--space-xs); }
.venue-list { display: flex; flex-direction: column; gap: var(--space-xs); }
.home-page .venue-card { display: flex; align-items: stretch; gap: var(--space-xs); width: 100%; padding: var(--space-xs) 0; border: 0; border-bottom: var(--rule-hairline) solid var(--color-rule); border-radius: 0; background: transparent; color: var(--color-ink); text-align: left; white-space: normal; line-height: var(--line-base); box-shadow: none; }
.venue-cover { flex-shrink: 0; width: calc(var(--space-xl) * 3); height: calc(var(--space-xl) * 4); border-radius: var(--radius-md); background: var(--color-paper-2); }
.venue-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.venue-name { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; font-family: var(--font-display); font-size: var(--text-base); font-weight: var(--font-weight-semibold); line-height: var(--line-base); }
.venue-sports { margin-top: var(--space-3xs); color: var(--color-ink-2); }
.venue-sports, .venue-address { display: block; overflow: hidden; font-size: var(--text-xs); font-weight: var(--font-weight-regular); text-overflow: ellipsis; white-space: nowrap; }
.venue-address { color: var(--color-muted); }
.venue-price-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2xs); margin-top: auto; padding-top: var(--space-2xs); }
.venue-price { color: var(--color-ink); font-size: var(--text-md); font-weight: var(--font-weight-bold); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.price-unavailable { color: var(--color-muted); font-size: var(--text-sm); font-weight: var(--font-weight-regular); }
.venue-arrow { flex-shrink: 0; width: var(--space-sm); height: var(--space-sm); }
.next-time { display: block; color: var(--color-muted); font-size: var(--text-xs); font-weight: var(--font-weight-regular); }
.next-time.is-available { color: var(--color-success-strong); }
.home-error { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); margin-bottom: var(--space-xs); padding: var(--space-xs); border-radius: var(--radius-md); background: var(--color-danger-soft); color: var(--color-danger-strong); font-size: var(--text-sm); }
.home-error > text { min-width: 0; overflow-wrap: anywhere; }
.home-page .retry-button { flex-shrink: 0; min-height: var(--touch-target); padding: 0 var(--space-2xs); background: transparent; color: var(--color-danger-strong); font-size: var(--text-sm); line-height: var(--touch-target); }
.home-empty { display: flex; flex-direction: column; align-items: center; gap: var(--space-2xs); padding: var(--space-3xl) var(--space-sm); color: var(--color-ink-2); font-size: var(--text-sm); text-align: center; }
.home-empty .empty-title { margin-top: var(--space-2xs); color: var(--color-ink); font-size: var(--text-base); }
.empty-icon { width: var(--space-xl); height: var(--space-xl); }
.venue-skeleton { display: flex; gap: var(--space-xs); padding: var(--space-xs); border: var(--rule-hairline) solid var(--color-rule); border-radius: var(--radius-card); background: var(--color-surface); }
.skeleton-cover { flex-shrink: 0; width: calc(var(--space-xl) * 3); height: calc(var(--space-xl) * 4); border-radius: var(--radius-md); background: var(--color-paper-2); }
.skeleton-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; gap: var(--space-sm); min-width: 0; }
.skeleton-line { width: 72%; height: var(--space-xs); border-radius: var(--radius-sm); background: var(--color-paper-2); }
.skeleton-line-wide { width: 92%; }
.skeleton-line-short { width: 48%; }
.home-page button:active, .home-page .control-pressed, .home-page .venue-card-pressed { opacity: .75; transform: none; }
.home-page button:focus-visible, .search-input:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--focus-offset); }

.home-date-strip { width: 100%; }
.home-dates { display: grid; grid-template-columns: repeat(7, minmax(44px, 1fr)); gap: var(--space-3xs); margin-top: var(--space-xs); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-rule); }
.home-page .quick-date { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 52px; min-width: 0; padding: var(--space-2xs) 0; gap: var(--space-3xs); border-radius: var(--radius-sm); background: transparent; color: var(--color-muted); font-size: var(--text-xs); line-height: var(--line-tight); font-weight: var(--font-weight-regular); }
.quick-date .date-number { font-size: var(--text-base); font-weight: var(--font-weight-semibold); }
.home-page .quick-date.is-selected { background: var(--color-primary-soft); color: var(--color-primary); }
