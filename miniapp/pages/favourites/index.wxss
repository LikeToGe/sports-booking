.favourites-page { max-width:640px; margin:0 auto; padding:var(--space-sm); }.target-favourite { display:flex; align-items:center; justify-content:space-between; gap:var(--space-xs); padding:var(--space-xs); margin-bottom:var(--space-md); }.favourites-page .venue-list { display:flex; flex-direction:column; gap:var(--space-xs); margin-bottom:var(--space-md); }.venue-row { display:flex; flex-direction:column; align-items:flex-start; gap:var(--space-3xs); width:100%; padding:var(--space-xs); color:var(--color-ink); text-align:left; }.venue-row .inline-action { align-self:flex-end; }
