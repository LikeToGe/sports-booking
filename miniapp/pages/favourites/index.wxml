<operation-toast /><view class="page favourites-page"><view class="screen-head"><text class="screen-title">常约场馆</text><text class="muted">收藏和最近预约会跨设备保留。</text></view><view wx:if="{{targetVenueId}}" class="target-favourite surface"><text class="section-title">当前场馆</text><button class="button-primary" disabled="{{targetIsFavourite || loading}}" bindtap="addTarget">{{targetIsFavourite ? '已收藏' : '收藏当前场馆'}}</button></view><view wx:if="{{error}}" class="error" role="alert">{{error}}<button class="button-secondary" bindtap="load">重新加载</button></view><view class="section-head"><text class="section-title">我的收藏</text></view><view class="venue-list"><button wx:for="{{favourites}}" wx:key="id" class="venue-row surface" data-id="{{item.id}}" bindtap="open"><text>{{item.name}}</text><text class="muted">{{item.district || "区县未设置"}} · {{item.address}}</text><text class="status status-{{item.status === 'ACTIVE' ? 'active' : 'danger'}}">{{item.status === 'ACTIVE' ? '可预约' : '场馆已暂停，不可预约'}}</text><text class="inline-action" data-id="{{item.id}}" catchtap="toggle">取消收藏</text></button></view><view wx:if="{{!loading && !favourites.length}}" class="empty surface">还没有收藏场馆</view><view class="section-head"><text class="section-title">最近预约</text></view><view class="venue-list"><button wx:for="{{recent}}" wx:key="id" class="venue-row surface" data-id="{{item.id}}" bindtap="open"><text>{{item.name}}</text><text class="muted">{{item.district || "区县未设置"}} · {{item.address}}</text><text class="status status-{{item.status === 'ACTIVE' ? 'active' : 'danger'}}">{{item.status === 'ACTIVE' ? '可预约' : '场馆已暂停，不可预约'}}</text></button></view><view wx:if="{{!loading && !recent.length}}" class="empty surface">还没有已确认的历史预约</view></view>
