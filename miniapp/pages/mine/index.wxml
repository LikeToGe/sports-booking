<operation-toast />
<view class="page mine-page">
  <view class="screen-head"><text class="screen-title">我的</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="profile-summary"><image class="profile-avatar" src="/assets/icons/user.svg" aria-hidden="true" /><view class="profile-copy"><text class="profile-name">{{profile.contactName || '预约用户'}}</text><text class="muted">{{profile.phone || '完善联系人，预约更方便'}}</text></view><button class="profile-edit" bindtap="toggleProfileForm" aria-label="编辑联系人" aria-expanded="{{showProfileForm}}"><image src="/assets/icons/chevron-down.svg" aria-hidden="true" /></button></view>
  <view class="profile-shortcuts"><button bindtap="openBookings"><image src="/assets/icons/calendar.svg" aria-hidden="true" /><text>我的预约</text></button><button bindtap="openFavourites"><image src="/assets/icons/courts.svg" aria-hidden="true" /><text>常约场馆</text></button><button bindtap="openMembership"><image src="/assets/icons/membership.svg" aria-hidden="true" /><text>场馆会员</text></button><button data-mode="messages" bindtap="community"><image src="/assets/icons/community.svg" aria-hidden="true" /><text>消息中心</text></button></view>
  <view wx:if="{{showProfileForm}}" class="profile-panel surface"><view class="section-head"><text class="section-title">常用联系人</text><text wx:if="{{saved}}" class="saved">已保存</text></view><view class="profile-form"><label class="field"><text class="field-label">联系人</text><input class="field-control" value="{{contactName}}" bindinput="onName" /></label><label class="field"><text class="field-label">手机号</text><input class="field-control" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" /></label><button class="button-primary" bindtap="save">保存资料</button></view></view>
  <view class="community-section"><text class="section-title">个人与记录</text><button class="staff-row" bindtap="toggleProfileForm"><text>常用联系人</text><text class="arrow">›</text></button><button class="staff-row" bindtap="openReminders"><text>提醒登记</text><text class="arrow">›</text></button><block wx:if="{{ugcEnabled}}"><button class="staff-row" data-mode="posts" bindtap="community"><text>我的发布</text><text class="arrow">›</text></button><button class="staff-row" data-mode="reports" bindtap="community"><text>举报与申诉</text><text class="arrow">›</text></button><button class="staff-row" bindtap="agreement"><text>社区协议</text><text class="arrow">›</text></button></block></view>
  <view class="staff-section"><text class="section-title">场馆工作</text><view wx:if="{{staffActive}}" class="staff-actions"><button class="staff-row" bindtap="webLogin"><text>Web 后台扫码登录</text><text class="arrow">›</text></button><button wx:if="{{canVerify || canIdentifyMember}}" class="staff-row" bindtap="verify"><text>核销与会员识别</text><text class="arrow">›</text></button><button wx:if="{{canVerify}}" class="staff-row" bindtap="records"><text>我的核销记录</text><text class="arrow">›</text></button></view><button wx:else class="staff-row" bindtap="bindStaff"><text>绑定场馆员工身份</text><text class="arrow">›</text></button></view>
  <view wx:if="{{showLocalDebug}}" class="debug-section surface"><view class="section-head"><text class="section-title">本地联调</text><text wx:if="{{connectionMessage}}" class="saved">{{connectionMessage}}</text></view><label class="field"><text class="field-label">API 地址</text><input class="field-control debug-address" value="{{apiBase}}" type="text" bindinput="onApiBase" /></label><button class="button-secondary" disabled="{{reconnecting || !apiBase}}" bindtap="reconnect">{{reconnecting ? '正在连接' : '保存并重连'}}</button></view>
  <view class="account-section"><text class="section-title">账号设置</text><button class="button-danger" disabled="{{closing || !profile}}" bindtap="closeAccount">{{closing ? '处理中' : '注销账号'}}</button></view>
</view>
