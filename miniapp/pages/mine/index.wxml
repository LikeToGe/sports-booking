<view class="page mine-page">
  <view class="screen-head"><text class="screen-title">我的</text><text class="muted">预约联系人与场馆员工身份。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="profile-panel surface"><view class="section-head"><text class="section-title">常用联系人</text><text wx:if="{{saved}}" class="saved">已保存</text></view><view class="profile-form"><label class="field"><text class="field-label">联系人</text><input class="field-control" value="{{contactName}}" bindinput="onName" /></label><label class="field"><text class="field-label">手机号</text><input class="field-control" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" /></label><button class="button-secondary" bindtap="save">保存资料</button></view></view>
  <view class="staff-section surface"><text class="section-title">场馆工作</text><view wx:if="{{staffActive}}" class="staff-actions"><button class="staff-row" bindtap="verify"><text>扫码或短码核销</text><text class="arrow">›</text></button><button class="staff-row" bindtap="records"><text>我的核销记录</text><text class="arrow">›</text></button></view><button wx:else class="staff-row" bindtap="bindStaff"><text>绑定场馆员工身份</text><text class="arrow">›</text></button></view>
</view>
