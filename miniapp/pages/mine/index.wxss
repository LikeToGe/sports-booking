/* 场边工作台 · pages/mine/index.wxss */
.mine-page { display: grid; align-content: start; gap: 22rpx; }
.mine-page .screen-head { padding-bottom: 0; }
.profile-panel, .staff-section, .debug-section, .profile-form, .staff-actions { display: grid; gap: 22rpx; }
.profile-panel { padding: 20px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); box-shadow: none; }
.staff-section { padding: 18px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); box-shadow: none; }
.debug-section { padding: 22rpx; border: 1rpx dashed var(--rule); border-radius: var(--radius-card); background: transparent; box-shadow: none; }
.saved { color: var(--accent-strong); font-size: 12px; }
.debug-address { font-family: monospace; font-size: 12px; }
.staff-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; padding: 0; border-bottom: 1rpx solid var(--rule-2); border-radius: 0; background: transparent; color: var(--ink); text-align: left; }
.staff-row:last-child { border-bottom: 0; }
.arrow { color: var(--muted); font-size: 20px; font-weight: 400; }
.community-section { display: grid; gap: 18rpx; padding: 18px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); }
.button-danger { min-height: 44px; }

.profile-summary { display: flex; align-items: center; gap: 16px; padding: 12px 0; }
.profile-avatar { flex-shrink: 0; width: 56px; height: 56px; padding: 16px; border-radius: 50%; background: var(--color-primary-soft); }
.profile-copy { display: grid; gap: 8px; min-width: 0; }
.profile-copy .muted { font-size: 12px; overflow-wrap: anywhere; }
.profile-name { font-size: 20px; font-weight: 600; }
.profile-edit { flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; margin-left: auto; padding: 0; background: transparent; }
.profile-edit image { width: 18px; height: 18px; }
.profile-shortcuts { display: flex; justify-content: space-around; padding: 16px 8px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); }
.profile-shortcuts button { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8px; min-height: 56px; padding: 0; background: transparent; color: var(--ink); font-size: 12px; }
.profile-shortcuts image { width: 22px; height: 22px; }
.staff-row { min-height: 48px; }
.account-section { display: grid; gap: 16px; padding: 16px 0; }

.staff-actions { gap: 0; }
.community-section { gap: 0; }
.community-section > .section-title, .staff-section > .section-title { margin-bottom: 10px; font-size: 14px; }
.staff-row { white-space: normal; gap: 12px; font-size: 14px; }
.account-section { padding: 18px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); }
