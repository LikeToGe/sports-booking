<operation-toast />
<view class="page bind-page">
  <view class="screen-head"><text class="screen-title">绑定员工身份</text><text class="muted">输入场馆管理员提供的 6 位绑定码。</text></view>
  <image class="bind-symbol" src="/assets/icons/scan.svg" aria-hidden="true" /><view class="bind-panel surface"><label class="field"><text class="field-label">6 位绑定码</text><input class="field-control code-input" type="number" maxlength="6" value="{{code}}" disabled="{{loading || bound}}" bindinput="onCode" /></label><text class="muted helper">绑定成功后，可在“我的”进入核销工作台。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="task-footer"><button class="button-primary {{loading ? 'is-busy' : ''}} {{bound ? 'is-complete' : ''}}" disabled="{{loading || code.length !== 6 || bound}}" bindtap="bind"><action-feedback busy="{{loading}}" done="{{bound}}" label="确认绑定" busy-label="正在绑定" done-label="绑定成功" bindcomplete="finishBind" /></button></view>
</view>
