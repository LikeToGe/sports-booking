<operation-toast />
<view class="page staff-recharge-page">
  <view class="screen-head"><text class="screen-title">员工人工充值</text><text class="muted">为 {{customerName}} 登记一笔真实收款充值。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="surface recharge-customer"><text class="section-title">场馆顾客</text><view><text class="muted">姓名</text><text>{{customerName}}</text></view></view><view class="plan-section surface"><text class="section-title">充值档位</text><button wx:for="{{plans}}" wx:key="id" class="plan-row surface {{selectedPlanId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" disabled="{{submitting || result}}" bindtap="selectPlan" aria-pressed="{{selectedPlanId === item.id}}"><selection-mark checked="{{selectedPlanId === item.id}}" /><text>{{item.name}}</text><strong>{{item.amountLabel}}</strong></button></view>
  <label wx:if="{{plans.length}}" class="field"><text class="field-label">实收渠道</text><picker mode="selector" range="{{channels}}" range-key="label" value="{{channelIndex}}" disabled="{{submitting || result}}" bindchange="selectChannel"><view class="field-control channel-picker">{{channels[channelIndex].label}}</view></picker></label>
  <button wx:if="{{plans.length}}" class="button-primary {{submitting ? 'is-busy' : ''}} {{result ? 'is-complete' : ''}}" disabled="{{submitting || result || !selectedPlanId}}" bindtap="submit"><action-feedback busy="{{submitting}}" done="{{!!result}}" label="确认充值" busy-label="充值处理中" done-label="充值完成" /></button>
  <view wx:if="{{result}}" class="recharge-result surface"><text class="section-title">充值完成</text><text>{{result.planName}}</text><text class="muted">充值记录 {{result.id}}</text></view>
  <view wx:if="{{!loading && !plans.length}}" class="empty surface"><text class="empty-title">没有启用的充值档位</text></view>
<view wx:if="{{loading}}" class="empty" role="status">正在加载，请稍候。</view>
</view>
