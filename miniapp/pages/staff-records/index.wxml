<operation-toast />
<view class="page records-page">
  <view class="screen-head"><text class="screen-title">我的核销记录</text><text class="muted">仅展示本人在所选场馆完成的核销。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <label wx:if="{{current}}" class="field"><text class="field-label">场馆</text><picker mode="selector" range="{{venues}}" range-key="venueName" value="{{selectedIndex}}" bindchange="selectVenue"><view class="field-control venue-picker">{{current.venueName}}</view></picker></label>
  <view class="records"><view wx:for="{{records}}" wx:key="id" class="record-card surface"><view class="record-head"><text class="section-title">{{item.contactName}}</text><text class="status status-active">已核销</text></view><view class="record-fact"><text class="muted">场地与运动</text><text>{{item.courtName}} · {{item.sportName}}</text></view><view class="record-fact"><text class="muted">核销方式</text><text>{{item.method === 'QR' ? '二维码' : '短码'}}</text></view><view class="record-fact"><text class="muted">核销时间</text><text class="record-time">{{item.time}}</text></view></view></view>

  <view wx:if="{{!loading && !error && !records.length}}" class="empty surface"><text class="empty-title">还没有核销记录</text><text>完成核销后会显示在这里。</text></view>
<view wx:if="{{loading}}" class="empty" role="status">正在加载，请稍候。</view>
</view>
