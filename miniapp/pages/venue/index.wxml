<operation-toast />
<view class="venue-page" wx:if="{{venue}}">
  <image class="hero-image" src="{{venue.coverPath || '/assets/venues/venue-1.jpg'}}" mode="aspectFill" aria-label="{{venue.name}}场馆封面" />
  <view class="page detail-body">
    <view class="venue-summary surface">
      <view class="venue-head"><view><text class="screen-title">{{venue.name}}</text><text class="muted address">{{venue.address}}</text></view><button class="button-secondary map-button" bindtap="openMap">导航</button></view>
      <view class="venue-actions"><text class="muted">{{venue.districtLabel}}</text><button class="button-secondary" bindtap="openFavourites">收藏与常约</button></view>
      <view class="facility-line"><text>{{venue.facilities || '场馆设施请咨询前台'}}</text></view>
    </view>

    <view class="booking-panel surface">
      <view class="booking-head"><view><text class="section-title">选择场次</text><text class="muted hint">一次预约一个完整具体场次</text></view><picker mode="date" value="{{date}}" bindchange="selectDate"><view class="date-button">{{date}}</view></picker></view>
      <scroll-view class="sport-strip" scroll-x enhanced show-scrollbar="{{false}}"><button class="sport-chip {{!sportTypeId ? 'is-active' : ''}}" data-id="" bindtap="selectSport">全部</button><button wx:for="{{sports}}" wx:key="id" class="sport-chip {{sportTypeId === item.id ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="selectSport">{{item.name}}</button></scroll-view>
      <view wx:if="{{startTime || minPriceFen !== '' || maxPriceFen !== ''}}" class="active-filters"><text>{{startTime ? startTime + '—' + endTime : '全天'}} · 单场价 {{minPriceFen !== '' ? minPriceFen / 100 + ' 元起' : '不限最低价'}} / {{maxPriceFen !== '' ? maxPriceFen / 100 + ' 元以内' : '不限最高价'}}</text><button class="button-secondary" bindtap="clearFilters" disabled="{{loading}}">清除时段和价格</button></view>
      <view wx:if="{{error}}" class="error" role="alert">{{error}}<button class="button-secondary" bindtap="load">重新加载</button></view>
      <view wx:if="{{preferenceNotice}}" class="preference-notice" role="status">{{preferenceNotice}}</view>
      <view class="view-switch"><button data-mode="list" bindtap="selectView" class="sport-chip {{viewMode === 'list' ? 'is-active' : ''}}" aria-label="按场地列表查看">列表</button><button data-mode="matrix" bindtap="selectView" class="sport-chip {{viewMode === 'matrix' ? 'is-active' : ''}}" aria-label="按时间和场地比较">时间 × 场地</button></view>
      <view wx:if="{{loading}}" class="muted" aria-live="polite">正在刷新场次，请稍候。</view>
      <view class="public-rules"><text>当前价格和取消截止以所选具体场次显示为准；确认预约时重新校验库存和价格。</text><text>入场须知：{{venue.entryNotice || '请按预约时间到场，如需帮助请联系场馆。'}}</text></view>
      <view wx:if="{{viewMode === 'list'}}" class="court-groups"><view wx:for="{{groups}}" wx:key="id" class="court-group"><view class="court-head"><view class="court-title"><image wx:if="{{item.imagePath}}" class="court-image" src="{{item.imagePath}}" mode="aspectFill" aria-label="{{item.name}}场地图片" /><text>{{item.name}}</text></view><text class="muted">{{item.sportNames}}</text></view><view class="slot-list"><button wx:for="{{item.slots}}" wx:for-item="slot" wx:key="id" class="slot-row" data-id="{{slot.id}}" bindtap="book" disabled="{{loading || error || slot.status !== 'OPEN'}}" aria-label="{{item.name}} {{slot.time}} {{slot.price}} {{slot.statusLabel}}"><text class="slot-time">{{slot.time}}</text><text class="price">{{slot.price}}</text><text class="book-label">{{slot.statusLabel}}</text><text class="slot-rule">取消截止 {{slot.cancelText}}</text><text wx:if="{{slot.preferred}}" class="slot-rule">原预约偏好</text></button></view></view></view>
      <view wx:if="{{viewMode === 'matrix' && matrixRows.length}}" class="comparison">
        <text class="muted hint">左右滑动比较场地；每个按钮是一场完整具体场次。</text>
        <scroll-view class="matrix-scroll" scroll-x enhanced show-scrollbar="{{true}}" aria-label="完整场次比较表，可左右滚动">
          <view class="matrix-table" style="width: {{matrixWidth}}rpx">
            <view class="matrix-line matrix-header"><view class="matrix-time">真实起止时间</view><view wx:for="{{matrixCourts}}" wx:key="id" class="matrix-cell">{{item.name}}</view></view>
            <view wx:for="{{matrixRows}}" wx:for-item="row" wx:key="key" class="matrix-line">
              <view class="matrix-time">{{row.time}}</view>
              <view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="courtId" class="matrix-cell">
                <button wx:for="{{cell.slots}}" wx:for-item="slot" wx:key="id" class="matrix-slot" data-id="{{slot.id}}" bindtap="book" disabled="{{loading || error || slot.status !== 'OPEN'}}" aria-label="{{slot.courtName}} {{slot.time}} {{slot.price}} {{slot.statusLabel}}，取消截止 {{slot.cancelText}}">
                  <text>{{slot.sportName}}</text><text class="price">{{slot.price}}</text><text class="book-label">{{slot.statusLabel}}</text><text class="slot-rule">取消截止 {{slot.cancelText}}</text><text wx:if="{{slot.preferred}}" class="slot-rule">原预约偏好</text>
                </button>
                <text wx:if="{{!cell.slots.length}}" class="muted">无此起止场次</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
      <view wx:if="{{!loading && !error && !groups.length}}" class="empty"><text class="empty-title">当前条件下没有具体场次</text><text>可主动清除条件、更换日期或运动后再查看。</text></view>
    </view>

    <view wx:if="{{ugcEnabled}}" class="reviews-section">
      <view class="section-head"><view><text class="section-title">场地评价</text><text class="muted">{{reviewSummary.reviewCount || 0}} 条已公开</text></view><button class="inline-action" bindtap="openReviews">查看全部</button></view>
      <view wx:if="{{reviewSummary.reviewCount}}" class="review-score"><strong>{{reviewSummary.overallScore}}</strong><text>总体评分</text></view>
      <view wx:for="{{reviews}}" wx:key="id" class="review-preview"><view><strong>{{item.overallScore}} 星</strong><text class="muted">{{item.sportName}} · {{item.visitMonth}}</text></view><text>{{item.body}}</text></view>
      <view wx:if="{{!reviewSummary.reviewCount}}" class="empty"><text>暂无公开评价</text></view>
    </view>
    <view class="notice surface"><text class="section-title">入场须知</text><text class="muted">{{venue.entryNotice || '请按预约时间到场，如需帮助请联系场馆。'}}</text></view>
  </view>
</view>
<view wx:elif="{{loading}}" class="page empty venue-loading" aria-live="polite"><text class="empty-title">正在加载场馆</text><text>正在整理可预约场次。</text></view>
<view wx:elif="{{error}}" class="page venue-load-error"><view class="error" role="alert">{{error}}</view><button class="button-secondary retry-button" bindtap="load">重新加载</button></view>
