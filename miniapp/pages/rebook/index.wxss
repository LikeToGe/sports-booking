.rebook-page { max-width: 640px; margin: 0 auto; padding: var(--space-sm); }.rebook-page .date-button { margin: var(--space-xs) 0; min-height: var(--touch-target); padding: 0 var(--space-xs); border: var(--rule-hairline) solid var(--color-rule-strong); border-radius: var(--radius-control); }.rebook-page .slot-list { display: flex; flex-direction: column; gap: var(--space-xs); }.rebook-page .slot-row { display: flex; justify-content: space-between; min-height: var(--touch-target); padding: var(--space-xs); background: var(--color-surface); color: var(--color-ink); }
