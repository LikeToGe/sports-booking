/* 场边工作台 · 再次预约 */
.rebook-page { display: grid; align-content: start; gap: 20px; }
.original-booking { display: grid; gap: 16px; padding: 20px; }
.original-booking > view { display: flex; justify-content: space-between; gap: 16px; }
.original-booking > view text:last-child { min-width: 0; text-align: right; }
.date-button { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border: 1px solid var(--color-rule-strong); border-radius: var(--radius-control); background: var(--surface); }
.rebook-page > .muted { padding: 18px; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-card); font-size: 12px; line-height: 1.8; }

.screen-head .screen-title { display: none; }
.screen-head { padding: 0; font-size: 12px; }
