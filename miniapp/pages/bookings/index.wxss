/* 场边工作台 · pages/bookings/index.wxss */
.bookings-page { display: grid; align-content: start; gap: 24rpx; }
.bookings-page .screen-head { padding-bottom: 8px; }
.booking-list { display: grid; gap: 16rpx; }
.booking-card { display: grid; gap: 12rpx; width: 100%; padding: 24rpx 22rpx 22rpx 26rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); color: var(--ink); text-align: left; line-height: 1.4; box-shadow: none; }
.booking-card:active { border-left-color: var(--accent-strong); background: var(--accent-soft); }
.booking-top, .booking-foot { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.status-line { display: flex; justify-content: flex-end; gap: 8rpx; flex-wrap: wrap; }
.date { color: var(--ink); font-size: 14px; font-weight: 500; font-variant-numeric: tabular-nums; }
.booking-court { color: var(--ink-2); font-size: 12px; }
.booking-foot { padding-top: 16rpx; border-top: 1rpx solid var(--rule-2); }
.booking-foot .price { font-size: 16px; }
.inline-action { min-height: 44px; margin-top: 16rpx; border: 1rpx solid var(--danger); border-radius: var(--radius-card); background: transparent; color: var(--danger-strong); }
@media (max-width: 360px) {
  .booking-top { align-items: start; }
  .status-line { display: grid; justify-items: end; }
}

.booking-card { white-space: normal; padding: 18px; gap: 12px; }
.booking-time { font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
.booking-open { font-size: 12px; color: var(--color-primary); }
.booking-top .section-title { min-width: 0; font-size: 15px; }
