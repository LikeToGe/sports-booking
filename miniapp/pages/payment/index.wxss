/* 场边工作台 · pages/payment/index.wxss */
.payment-page { display: grid; align-content: start; gap: 22rpx; }
.payment-page .screen-head { border-bottom: 1rpx solid var(--rule); }
.payment-card { display: grid; justify-items: start; gap: 20rpx; padding: 32rpx 28rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); text-align: left; box-shadow: none; }
.payment-card .section-head { width: 100%; }
.payment-card .muted { color: var(--muted); }
.amount { color: var(--ink); font-size: 36px; font-weight: 700; font-variant-numeric: tabular-nums; }
.countdown { color: var(--warning-strong); font-variant-numeric: tabular-nums; }
.payment-order { display: grid; width: 100%; gap: 8rpx; padding-top: 24rpx; border-top: 1rpx solid var(--rule); }
.composition { display: grid; gap: 0; padding: 24rpx; box-shadow: none; }
.composition .section-title { margin-bottom: 12rpx; }
.composition > view { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 44px; border-bottom: 1rpx solid var(--rule-2); }
.composition strong { font-variant-numeric: tabular-nums; }
.composition .external-row { border-bottom: 0; color: var(--signal-strong); }
.payment-actions { display: grid; gap: 14rpx; }
.info-message { padding: 20rpx 24rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--accent-soft); color: var(--signal-strong); }
.inline-action { min-height: 44px; margin-top: 16rpx; border: 1rpx solid var(--danger); border-radius: var(--radius-card); background: transparent; color: var(--danger-strong); }

.payment-page > .screen-head .screen-title { display: none; }
.payment-page > .screen-head { padding: 0; border: 0; font-size: 12px; }
