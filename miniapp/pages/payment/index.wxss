.payment-page { display: grid; align-content: start; gap: 22rpx; }
.payment-page .screen-head { border-bottom: 1rpx solid var(--rule); }
.payment-card { display: grid; justify-items: center; gap: 20rpx; padding: 32rpx 28rpx; border: 1px solid var(--rule); border-radius: 28rpx; background: var(--surface); color: var(--ink); text-align: center; box-shadow: none; }
.payment-card .section-head { width: 100%; }
.payment-card .muted { color: var(--muted); }
.amount { color: var(--color-primary); font-size: 76rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.countdown { color: var(--warning-strong); font-variant-numeric: tabular-nums; }
.payment-order { display: grid; width: 100%; gap: 8rpx; padding-top: 24rpx; border-top: 1rpx solid var(--rule); }
.composition { display: grid; gap: 0; padding: 24rpx; box-shadow: none; }
.composition .section-title { margin-bottom: 12rpx; }
.composition > view { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 76rpx; border-bottom: 1rpx solid var(--rule-2); }
.composition strong { font-variant-numeric: tabular-nums; }
.composition .external-row { border-bottom: 0; color: var(--signal-strong); }
.payment-actions { display: grid; gap: 14rpx; }
.info-message { padding: 20rpx 24rpx; border: 1rpx solid var(--accent-strong); border-radius: 16rpx; background: var(--accent-soft); color: var(--signal-strong); }
.inline-action { min-height: 72rpx; margin-top: 16rpx; border: 1rpx solid var(--danger); border-radius: 14rpx; background: transparent; color: var(--danger-strong); }
