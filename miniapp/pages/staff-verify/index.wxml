<view class="page verify-page">
  <view class="screen-head"><text class="screen-title">场馆工作</text><text class="muted">核销线上预约或识别本场馆顾客。</text></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <label wx:if="{{current}}" class="field"><text class="field-label">工作场馆</text><picker mode="selector" range="{{venues}}" range-key="venueName" value="{{selectedIndex}}" bindchange="selectVenue"><view class="field-control venue-picker">{{current.venueName}}</view></picker></label>
  <view wx:if="{{current && canVerify && canIdentify}}" class="work-tabs"><button class="{{mode === 'booking' ? 'is-active' : ''}}" data-mode="booking" bindtap="selectMode">预约核销</button><button class="{{mode === 'member' ? 'is-active' : ''}}" data-mode="member" bindtap="selectMode">会员识别</button></view>
  <block wx:if="{{current && (canVerify || canIdentify)}}">
    <button class="scan-button" bindtap="scan"><text class="scan-title">{{mode === 'booking' ? '扫描预约二维码' : '扫描会员码'}}</text><text class="scan-hint">打开相机扫码</text></button>
    <view wx:if="{{mode === 'booking'}}" class="code-panel surface"><text class="section-title">输入短码</text><view class="code-row"><input class="field-control code-input" type="number" maxlength="6" value="{{code}}" bindinput="onCode" /><button class="button-secondary" disabled="{{loading || code.length !== 6}}" bindtap="submitCode">核销</button></view></view>
    <view wx:else class="code-panel surface"><text class="section-title">输入会员码或完整手机号</text><view class="code-row"><input class="field-control member-input" value="{{memberIdentifier}}" bindinput="onMemberIdentifier" /><button class="button-secondary" disabled="{{loading || !memberIdentifier}}" bindtap="submitMember">识别</button></view></view>
  </block>
  <view wx:if="{{result}}" class="verify-result surface"><text class="section-title">核销完成</text><text>{{result.courtName}} · {{result.sportName}}</text><text class="muted">{{result.contactName}}</text></view>
  <view wx:if="{{memberResult}}" class="verify-result surface"><text class="section-title">顾客已识别</text><text>{{memberResult.contactName}} · {{memberResult.phone}}</text><text class="muted">{{memberResult.status === 'MEMBER' ? '储值会员' : '普通顾客'}} · {{memberResult.memberCode}}</text><button wx:if="{{canRecharge}}" class="button-primary" bindtap="recharge">为该会员充值</button></view>
  <button wx:if="{{mode === 'booking' && canVerify}}" class="staff-link" bindtap="records">查看当前场馆核销记录</button>
  <view wx:if="{{!loading && !current}}" class="empty surface"><text class="empty-title">没有可用的员工身份</text></view>
  <view wx:elif="{{current && !canVerify && !canIdentify}}" class="empty surface"><text class="empty-title">当前场馆未授权工作能力</text></view>
</view>
