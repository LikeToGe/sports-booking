/* 场边工作台 · pages/confirm/index.wxss */
.confirm-page, .form { display: grid; align-content: start; gap: 22rpx; }
.confirm-page .screen-head { border-bottom: 1rpx solid var(--rule); }
.summary { display: grid; gap: 14rpx; padding: 26rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); box-shadow: none; }
.summary .muted { color: var(--muted); }
.summary-total { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid var(--rule); }
.total { color: var(--ink); font-size: 24px; white-space: nowrap; }
.form-panel { display: grid; gap: 24rpx; padding: 26rpx; box-shadow: none; }
.rule { display: grid; gap: 10rpx; padding: 22rpx 24rpx; border-radius: var(--radius-card); background: var(--surface); border: 1px solid var(--rule); color: var(--ink-2); font-size: 26rpx; }
.confirm-load-error { display: grid; align-content: start; gap: 20rpx; }

.confirm-page > .screen-head .screen-title { display: none; }
.confirm-page > .screen-head { padding: 0; border: 0; font-size: 12px; }
