.confirm-page, .form { display: grid; align-content: start; gap: 24rpx; }
.summary { display: grid; gap: 14rpx; padding: 28rpx; }
.summary-total { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; padding-top: 20rpx; border-top: 2rpx solid var(--rule-2); }
.total { font-size: 46rpx; white-space: nowrap; }
.form-panel { display: grid; gap: 24rpx; padding: 28rpx; }
.rule { display: grid; gap: 10rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: var(--signal-soft); font-size: 26rpx; }
