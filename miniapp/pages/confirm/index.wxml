<operation-toast />
<view class="page confirm-page" wx:if="{{slot}}">
  <view class="screen-head"><text class="screen-title">确认预约</text><text class="muted">确认场次和联系人。</text></view>
  <view class="summary surface"><text class="muted">{{slot.venueName}}</text><text class="section-title">{{slot.courtName}} · {{slot.sportName}}</text><text>{{slot.dateLabel}}　{{slot.time}}</text><view class="summary-total"><text class="muted">预约总额</text><text class="price total">{{slot.price}}</text></view></view>
  <view class="form-panel surface"><text class="section-title">联系人</text><view class="form"><label class="field"><text class="field-label">姓名</text><input class="field-control" value="{{contactName}}" disabled="{{loading || created}}" bindinput="onName" /></label><label class="field"><text class="field-label">手机号</text><input class="field-control" type="number" maxlength="11" value="{{contactPhone}}" disabled="{{loading || created}}" bindinput="onPhone" /></label></view></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view class="rule"><text>取消规则</text><text class="muted">超过场馆规定的取消截止时间后不可自行取消。</text></view>
  <view class="task-footer"><button class="button-primary {{loading ? 'is-busy' : ''}} {{created ? 'is-complete' : ''}}" disabled="{{loading || !contactName || !contactPhone || created}}" bindtap="submit"><action-feedback busy="{{loading}}" done="{{created}}" label="确认预约" busy-label="正在创建预约" done-label="预约已创建" bindcomplete="openCreatedBooking" /></button></view>
</view>
<view wx:elif="{{loading}}" class="page empty" aria-live="polite"><text class="empty-title">正在准备预约</text><text>正在读取联系人信息。</text></view>
<view wx:elif="{{error}}" class="page confirm-load-error"><view class="error" role="alert">{{error}}</view><button class="button-secondary retry-button" bindtap="onLoad">重新加载</button></view>
