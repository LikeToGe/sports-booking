/* 场边工作台 · pages/content-agreement/index.wxss */
.agreement-page { display: grid; align-content: start; gap: 28rpx; }
.agreement-section { display: grid; gap: 18rpx; padding: 20px; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); }
.agreement-text { white-space: pre-wrap; line-height: 1.65; overflow-wrap: anywhere; }
.agreement-check { display: flex; align-items: center; gap: 16rpx; min-height: 44px; }
.agreement-check { position: relative; padding: 12px; border: 1px solid var(--rule); border-radius: var(--radius-control); transition: background-color 180ms var(--ease-out), border-color 180ms var(--ease-out); }
.agreement-check.is-checked { border-color: var(--color-primary); background: var(--color-primary-soft); }
.agreement-native { position: absolute; left: 12px; opacity: 0; }

.agreement-page > .screen-head .screen-title { display: none; }
.agreement-page > .screen-head { padding: 0; border: 0; font-size: 12px; }
