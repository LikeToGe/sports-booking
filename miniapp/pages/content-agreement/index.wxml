<operation-toast />
<view class="page agreement-page">
  <view class="screen-head"><text class="screen-title">社区协议</text></view>
  <view wx:if="{{loading}}" class="empty">正在加载</view>
  <block wx:elif="{{agreement}}">
    <view class="agreement-section"><text class="section-title">社区规则 · {{agreement.rulesVersion}}</text><text class="agreement-text">{{agreement.rulesText}}</text></view>
    <view class="agreement-section"><text class="section-title">隐私说明 · {{agreement.privacyVersion}}</text><text class="agreement-text">{{agreement.privacyText}}</text></view>
    <checkbox-group bindchange="toggle"><label class="agreement-check {{checked || agreement.accepted ? 'is-checked' : ''}}"><checkbox class="agreement-native" color="#087F72" value="accept" checked="{{checked || agreement.accepted}}" disabled="{{saving || agreement.accepted || accepted}}" /><selection-mark checked="{{checked || agreement.accepted}}" /><text>我已阅读并同意当前版本</text></label></checkbox-group>
    <button class="button-primary {{saving ? 'is-busy' : ''}} {{accepted || agreement.accepted ? 'is-complete' : ''}}" disabled="{{!checked || saving || accepted || agreement.accepted}}" bindtap="accept"><action-feedback busy="{{saving}}" done="{{accepted || agreement.accepted}}" label="同意并继续" busy-label="提交中" done-label="已同意" bindcomplete="finishAccept" /></button>
  </block>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
</view>
