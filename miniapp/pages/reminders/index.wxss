/* 场边工作台 · pages/reminders/index.wxss */
.reminders-page { display: grid; gap: 18rpx; }
.reminder-form, .reminder-row { display: grid; gap: 18rpx; padding: 24rpx; }
.time-row { display: flex; align-items: center; gap: 12rpx; }
.time-row picker { flex: 1; min-width: 0; }
.reminder-row { grid-template-columns: minmax(0, 1fr); align-items: center; }
.reminder-focus { display: grid; gap: 14rpx; padding: 24rpx; }
.reminder-actions { display: flex; gap: 8rpx; }
.reminder-slot { display: flex; justify-content: space-between; gap: 12rpx; padding: 10rpx 0; border-top: 1rpx solid var(--rule); }
.block { display: block; margin-top: 8rpx; }

.saved { padding: 12px; background: var(--success-soft); color: var(--success-strong); }
.reminder-form .muted, .reminder-row .muted { font-size: 12px; line-height: 1.7; }

.screen-head .screen-title { display: none; }
.screen-head { padding: 0; font-size: 12px; }
