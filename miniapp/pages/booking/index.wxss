/* 场边工作台 · pages/booking/index.wxss */
.detail-page { display: grid; align-content: start; gap: 20rpx; }
.detail-head { display: flex; align-items: start; justify-content: space-between; gap: 24rpx; padding: 28rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); color: var(--ink); box-shadow: none; }
.detail-head .screen-title { color: var(--ink); }
.detail-head .muted { color: var(--muted); }
.block { margin-top: 10rpx; font-size: 12px; }
.amount-block { display: grid; justify-items: end; gap: 10rpx; flex: 0 0 auto; }
.amount { font-size: 22px; white-space: nowrap; }
.detail-head .amount { color: var(--ink); }
.facts { display: grid; gap: 22rpx; padding: 26rpx; box-shadow: none; }
.facts > view { display: grid; grid-template-columns: 120rpx minmax(0, 1fr); gap: 20rpx; }
.composition, .external-payment, .refund-panel { display: grid; gap: 0; padding: 24rpx; box-shadow: none; }
.composition .section-title { margin-bottom: 12rpx; }
.composition-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 44px; border-bottom: 1rpx solid var(--rule-2); }
.composition strong, .refund-facts { font-variant-numeric: tabular-nums; }
.lot-list { display: grid; margin-top: 12rpx; }
.lot-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8rpx 20rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--rule-2); font-size: 12px; }
.lot-row .muted { grid-column: 1 / -1; }
.external-payment, .refund-panel { gap: 18rpx; }
.external-payment-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-width: 0; }
.external-payment-row .muted { min-width: 0; overflow-wrap: anywhere; }
.refund-facts { display: grid; gap: 10rpx; }
.error-text { color: var(--danger-strong); }
.credential { display: grid; justify-items: center; gap: 18rpx; padding: 28rpx; border: 1px solid var(--rule); border-radius: var(--radius-card); background: var(--surface); text-align: center; box-shadow: none; }
.qr { width: 190px; height: 190px; padding: 12rpx; border-radius: var(--radius-card); background: var(--on-dark); }
.short-code { font-size: 24px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 2px; }
.retry-button { margin-top: 20rpx; }
@media (max-width: 360px) {
  .detail-head { align-items: stretch; flex-direction: column; }
  .amount-block { justify-items: start; }
}

.credential .muted { font-size: 12px; line-height: 1.7; }
.detail-head .screen-title { font-size: 22px; }
.facts > view > text:last-child { min-width: 0; text-align: right; overflow-wrap: anywhere; }
