<operation-toast />
<view class="page posts-page">
  <view class="section-head"><view class="screen-head"><text class="screen-title">运动动态</text><text class="muted">分享运动现场和约球想法</text></view><button wx:if="{{enabled}}" class="button-primary editor-toggle" bindtap="toggleEditor" aria-expanded="{{showEditor}}">{{showEditor ? '收起发布器' : '发布动态'}}</button></view>
  <view wx:if="{{enabled}}" class="mode-tabs"><button class="{{mode === 'posts' ? 'button-primary' : 'button-secondary'}}" data-mode="posts" bindtap="switchMode">动态</button><button class="{{mode === 'recruitments' ? 'button-primary' : 'button-secondary'}}" data-mode="recruitments" bindtap="switchMode">找搭子</button></view>
  <view wx:if="{{enabled && showEditor}}" class="post-editor surface">
    <text class="field-label">动态正文</text><textarea class="post-body" maxlength="2000" value="{{body}}" placeholder="说说今天的运动体验" bindinput="editBody" />
    <picker wx:if="{{sports.length}}" disabled="{{bookingId}}" range="{{sports}}" range-key="name" value="{{sportIndex}}" bindchange="selectSport"><view class="sport-picker">运动类型：{{sports[sportIndex].name}}</view></picker>
    <picker wx:if="{{venues.length}}" disabled="{{bookingId}}" range="{{venues}}" range-key="name" value="{{venueIndex}}" bindchange="selectVenue"><view class="sport-picker">场馆：{{venues[venueIndex].name}}</view></picker>
    <picker wx:if="{{bookings.length}}" range="{{bookings}}" range-key="label" value="{{bookingIndex}}" bindchange="selectBooking"><view class="sport-picker">{{bookings[bookingIndex].label}}</view></picker>
    <view wx:if="{{selectedMedia.length}}" class="media-preview">
      <block wx:for="{{selectedMedia}}" wx:key="path">
        <image wx:if="{{item.type === 'image'}}" src="{{item.path}}" mode="aspectFill" />
        <video wx:else src="{{item.path}}" controls />
      </block>
    </view>
    <view wx:if="{{existingMediaCount && !selectedMedia.length}}" class="muted">已保留 {{existingMediaCount}} 项媒体</view>
    <view class="media-actions"><button class="button-secondary" disabled="{{saving}}" bindtap="chooseMedia">选择图片或视频</button><button wx:if="{{selectedMedia.length || existingMediaCount}}" class="button-secondary" disabled="{{saving}}" bindtap="clearMedia">移除媒体</button></view>
    <view class="editor-actions"><text class="muted">{{editingId ? "修改动态" : "发布动态"}}</text><button class="button-primary" disabled="{{saving}}" bindtap="publish">{{saving ? "提交中" : editingId ? "提交修改" : "发布"}}</button></view>
  </view>
  <view wx:if="{{enabled && mode === 'posts'}}" class="filters surface">
    <picker range="{{filterSports}}" range-key="name" value="{{filterSportIndex}}" bindchange="selectFilterSport"><view>{{filterSports[filterSportIndex].name}}</view></picker>
    <picker range="{{filterVenues}}" range-key="name" value="{{filterVenueIndex}}" bindchange="selectFilterVenue"><view>{{filterVenues[filterVenueIndex].name}}</view></picker>
  </view>
  <view wx:if="{{enabled && mode === 'recruitments'}}" class="filters surface">
    <picker mode="date" value="{{recruitmentDate}}" data-field="recruitmentDate" bindchange="onRecruitmentFilter" aria-label="场次日期"><view>{{recruitmentDate || "选择场次日期"}}</view></picker>
    <picker range="{{filterSports}}" range-key="name" value="{{filterSportIndex}}" bindchange="selectFilterSport"><view>{{filterSports[filterSportIndex].name}}</view></picker>
    <picker range="{{filterVenues}}" range-key="name" value="{{filterVenueIndex}}" bindchange="selectFilterVenue"><view>{{filterVenues[filterVenueIndex].name}}</view></picker>
    <picker range="{{['不限水平','新手友好','休闲','进阶']}}" value="{{recruitmentLevelIndex}}" data-field="recruitmentLevel" bindchange="onRecruitmentFilter"><view>{{recruitmentLevelLabel}}</view></picker>
    <input type="number" placeholder="最少剩余名额" value="{{recruitmentMinRemaining}}" data-field="recruitmentMinRemaining" bindinput="onRecruitmentFilter" />
  </view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button class="button-secondary" bindtap="retryLoad">重新加载</button></view>
  <view wx:if="{{message}}" class="saved-message" role="status">{{message}}</view>
  <view wx:if="{{mode === 'posts'}}" class="post-list">
    <view wx:for="{{posts}}" wx:key="id" class="post-card surface" data-id="{{item.id}}" bindtap="openDetail">
      <view class="post-meta"><view class="post-author"><image class="author-avatar" src="/assets/icons/user.svg" aria-hidden="true" /><view><text class="section-title">{{item.authorName || (item.isOfficial ? '官方动态' : '球友')}}</text><text class="muted">{{item.sportName}} · {{item.venueName || '运动动态'}}</text></view></view></view>
      <text class="post-text">{{item.body}}</text>
      <image wx:if="{{item.previewPath}}" class="post-preview" src="{{item.previewPath}}" mode="aspectFill" lazy-load aria-label="动态图片" /><text wx:if="{{item.previewError}}" class="muted">图片暂不可用，可进入详情重试。</text><text wx:if="{{item.media.length}}" class="muted">{{item.media[0].mediaType === 'VIDEO' ? '视频' : '图片'}} · {{item.media.length}}</text>
      <view class="post-foot"><text class="muted">{{item.isOfficial ? '官方动态' : '用户动态'}}</text><view wx:if="{{item.isMine}}" class="post-actions"><button class="inline-action" data-id="{{item.id}}" catchtap="edit">编辑</button><button class="inline-action" data-id="{{item.id}}" catchtap="remove">删除</button></view></view>
    </view>
  </view>
  <view wx:if="{{enabled && mode === 'recruitments'}}" class="post-list">
    <view wx:for="{{recruitments}}" wx:key="recruitmentId" class="post-card surface" data-post-id="{{item.postId}}" bindtap="openRecruitment">
      <view class="post-meta"><text class="section-title">{{item.venueName}}</text><text class="muted">{{item.sportName}}</text></view>
      <text>{{item.startLabel}}–{{item.endLabel}} · {{item.levelLabel}}</text>
      <text>{{item.approvedCount}} / {{item.maxMembers}} 人 · 剩余 {{item.remainingCount}}</text>
      <text>{{item.feeLabel}} · 已订场，预约有效</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="empty" role="status">正在加载{{mode === 'recruitments' ? '找搭子' : '运动动态'}}</view><view wx:if="{{!enabled && !loading}}" class="empty"><text>动态功能暂未开放</text></view>
  <view wx:if="{{enabled && mode === 'posts' && !loading && !posts.length && !error}}" class="empty"><text>还没有动态</text></view>
  <view wx:if="{{enabled && mode === 'recruitments' && !loading && !recruitments.length && !error}}" class="empty"><text>暂无符合条件的找搭子</text></view>
</view>
