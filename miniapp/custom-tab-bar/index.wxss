@import "../tokens.wxss";
/* 场边工作台 · 4/5 个入口按稳定路径等宽排列 */
.tab-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: var(--z-sticky-nav); display: flex; align-items: center; min-height: var(--bottom-nav-height); padding: var(--space-3xs) var(--space-2xs) calc(var(--space-3xs) + env(safe-area-inset-bottom)); border-top: var(--rule-hairline) solid var(--color-rule); background: var(--color-surface); }
.tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3xs); min-width: 0; min-height: calc(var(--bottom-nav-height) - var(--space-2xs)); margin: 0; padding: 0; border: 0; border-radius: var(--radius-control); background: transparent; color: var(--color-muted); line-height: var(--line-tight); }
.tab::after { border: 0; }
.tab-icon-wrap { display: flex; align-items: center; justify-content: center; width: var(--touch-target); height: calc(var(--space-lg) + var(--space-3xs)); border-radius: var(--radius-control); }
.tab-icon { display: block; width: var(--space-lg); height: var(--space-lg); opacity: .72; }
.tab-label { font-family: var(--font-body); font-size: var(--text-xs); font-weight: var(--font-weight-medium); white-space: nowrap; }
.tab.is-selected { color: var(--color-primary); }
.tab.is-selected .tab-icon-wrap { background: var(--color-primary-soft); }
.tab.is-selected .tab-icon { opacity: 1; }
.tab.is-selected .tab-label { font-weight: var(--font-weight-semibold); }
.tab:active, .tab-pressed { opacity: .7; transform: none; }
.tab:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: calc(-1 * var(--focus-width)); }
