/* Hallmark · genre: modern-minimal · macrostructure: Ecosystem Index · theme: Nike-design-analysis · design-system: design.md · designed-as-app
 * pre-emit critique: P5 H5 E5 S5 R5 V5
 * contrast: pass · touch: 44pt floor · chrome: native · icons: no mixed set
 */
page {
  --paper: oklch(100% 0 0);
  --paper-2: oklch(97.02% 0 0);
  --surface: oklch(100% 0 0);
  --surface-card: oklch(97.02% 0 0);
  --ink: oklch(17.76% 0 0);
  --ink-2: oklch(34.53% 0.0034 286.2);
  --muted: oklch(54.58% 0.0031 286.3);
  --rule: oklch(83.93% 0.0014 286.4);
  --rule-2: oklch(92.19% 0 0);
  --accent: oklch(17.76% 0 0);
  --accent-strong: oklch(26.03% 0 0);
  --accent-soft: oklch(97.02% 0 0);
  --accent-ink: oklch(100% 0 0);
  --signal: oklch(52.84% 0.2624 263.8);
  --signal-strong: oklch(45.37% 0.2602 264);
  --signal-soft: oklch(97.05% 0.0142 254.6);
  --success: oklch(51.84% 0.1261 155.8);
  --success-strong: oklch(51.84% 0.1261 155.8);
  --success-soft: oklch(96% 0.025 155.8);
  --warning: oklch(76.86% 0.1647 70.1);
  --warning-strong: oklch(47.32% 0.1247 46.2);
  --warning-soft: oklch(96% 0.028 70.1);
  --danger: oklch(54.45% 0.2231 28.8);
  --danger-strong: oklch(36.33% 0.1441 30.4);
  --danger-soft: oklch(96% 0.025 25.3);
  --shadow: oklch(17.76% 0 0 / 6%);
  --font-display: "Nike Futura ND", "Arial Black", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-body: "Helvetica Now Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  min-height: 100%;
  overflow-x: clip;
  background: var(--paper-2);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 28rpx;
  letter-spacing: 0;
}

view, text, button, input, textarea, picker, image { box-sizing: border-box; letter-spacing: 0; }
button { margin: 0; border-radius: 999rpx; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
button::after { border: 0; }
button:active { opacity: 0.78; }

.page { min-height: 100vh; padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.screen-head { display: grid; gap: 8rpx; padding-bottom: 24rpx; border-bottom: 4rpx solid var(--ink); }
.screen-title { display: block; font-family: var(--font-display); font-size: 42rpx; font-weight: 700; line-height: 1.1; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-title { display: block; font-family: var(--font-display); font-size: 32rpx; font-weight: 700; line-height: 1.2; }
.block { display: block; }
.muted { color: var(--muted); }

.surface { border: 2rpx solid var(--rule); border-radius: 0; background: var(--surface); box-shadow: none; }
.price { color: var(--ink); font-variant-numeric: tabular-nums; font-weight: 600; }

.button-primary, .button-secondary, .button-danger { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 28rpx; line-height: 1; }
.button-primary { background: var(--accent); color: var(--accent-ink); }
.button-secondary { border: 2rpx solid var(--paper-2); background: var(--paper-2); color: var(--ink); }
.button-danger { border: 2rpx solid var(--danger); background: var(--surface); color: var(--danger-strong); }
.button-primary[disabled], .button-secondary[disabled], .button-danger[disabled] { opacity: 0.45; }

.field { display: grid; gap: 10rpx; }
.field-label { color: var(--ink-2); font-size: 24rpx; font-weight: 600; }
.field-control { min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid var(--rule); border-radius: 999rpx; background: var(--surface); }
.field-control:focus { border-color: var(--signal); }
.field-control[disabled] { background: var(--paper-2); opacity: 0.55; }
.error { padding: 20rpx 24rpx; border: 2rpx solid var(--danger); border-radius: 16rpx; background: var(--danger-soft); color: var(--danger-strong); }
.empty { display: grid; align-content: center; justify-items: center; min-height: 260rpx; gap: 12rpx; padding: 40rpx 28rpx; color: var(--muted); text-align: center; }
.empty-title { color: var(--ink-2); font-size: 30rpx; font-weight: 600; }

.status { display: inline-flex; align-items: center; min-height: 48rpx; padding: 0 14rpx; border: 2rpx solid var(--rule); border-radius: 8rpx; background: var(--surface); font-size: 22rpx; }
.status-active { border-color: var(--success); background: var(--success-soft); color: var(--success-strong); }
.status-warning { border-color: var(--warning); background: var(--warning-soft); color: var(--warning-strong); }
.status-danger { border-color: var(--danger); background: var(--danger-soft); color: var(--danger-strong); }
