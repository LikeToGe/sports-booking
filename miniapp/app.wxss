/* Hallmark · genre: playful · macrostructure: Ecosystem Index · design-system: design.md · designed-as-app
 * pre-emit critique: P5 H5 E5 S5 R5 V5
 * contrast: pass · touch: 44pt floor · chrome: native · icons: no mixed set
 */
page {
  --paper: oklch(98% 0.004 250);
  --paper-2: oklch(95% 0.006 250);
  --surface: oklch(99% 0.002 250);
  --ink: oklch(21% 0.018 250);
  --ink-2: oklch(35% 0.016 250);
  --muted: oklch(47% 0.012 250);
  --rule: oklch(84% 0.01 250);
  --rule-2: oklch(90% 0.008 250);
  --accent: oklch(52% 0.155 145);
  --accent-strong: oklch(44% 0.145 145);
  --accent-soft: oklch(94% 0.035 145);
  --accent-ink: oklch(98% 0.004 250);
  --signal: oklch(53% 0.17 31);
  --signal-soft: oklch(94% 0.035 31);
  --danger: oklch(53% 0.18 25);
  --danger-soft: oklch(95% 0.03 25);
  --shadow: oklch(21% 0.018 250 / 5%);
  min-height: 100%;
  background: var(--paper-2);
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view, text, button, input, textarea, picker, image { box-sizing: border-box; letter-spacing: 0; }
button { margin: 0; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
button::after { border: 0; }
button:active { opacity: 0.78; }

.page { min-height: 100vh; padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.screen-head { display: grid; gap: 8rpx; padding-bottom: 24rpx; }
.screen-title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.2; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; line-height: 1.3; }
.block { display: block; }
.muted { color: var(--muted); }

.surface { border: 2rpx solid var(--rule-2); border-radius: 16rpx; background: var(--surface); box-shadow: 0 8rpx 24rpx var(--shadow); }
.price { color: var(--signal); font-variant-numeric: tabular-nums; font-weight: 700; }

.button-primary, .button-secondary, .button-danger { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 28rpx; line-height: 1; }
.button-primary { background: var(--accent); color: var(--accent-ink); }
.button-secondary { border: 2rpx solid var(--rule); background: var(--surface); color: var(--ink); }
.button-danger { border: 2rpx solid var(--danger); background: var(--surface); color: var(--danger); }
.button-primary[disabled], .button-secondary[disabled], .button-danger[disabled] { opacity: 0.45; }

.field { display: grid; gap: 10rpx; }
.field-label { color: var(--ink-2); font-size: 24rpx; font-weight: 600; }
.field-control { min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid var(--rule); border-radius: 12rpx; background: var(--surface); }
.error { padding: 20rpx 24rpx; border: 2rpx solid var(--danger); border-radius: 12rpx; background: var(--danger-soft); color: var(--danger); }
.empty { display: grid; align-content: center; justify-items: center; min-height: 260rpx; gap: 12rpx; padding: 40rpx 28rpx; color: var(--muted); text-align: center; }
.empty-title { color: var(--ink-2); font-size: 30rpx; font-weight: 600; }

.status { display: inline-flex; align-items: center; min-height: 48rpx; padding: 0 14rpx; border: 2rpx solid var(--rule); border-radius: 8rpx; background: var(--surface); font-size: 22rpx; }
.status-active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-strong); }
.status-warning { border-color: var(--signal); background: var(--signal-soft); color: var(--signal); }
.status-danger { border-color: var(--danger); background: var(--danger-soft); color: var(--danger); }
