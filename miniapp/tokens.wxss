/* 场边工作台 · 与根 tokens.css 同名映射；组件根显式消费，避免原生 Tab 根不继承 page。 */
page, .tab-bar, .operation-toast {
  --color-paper: #F5F8F7;
  --color-rule-2: #ECF1ED;
  --color-highlight: #E9F4EE;
  --color-highlight-ink: #285F48;
  --color-info: #49677C;
  --color-info-strong: #49677C;
  --color-info-soft: #EEF2F5;
  --color-success: #285F48;
  --color-success-soft: #E9F4EE;
  --color-warning: #876125;
  --color-warning-strong: #876125;
  --color-warning-soft: #FAF3E4;
  --color-danger: #AC4949;
  --color-on-dark: #ffffff;
  --shadow-raised: none;
  /* 首页与底栏按根 tokens.css 映射；尺寸用 px 保证窄屏触控区域。 */
  --color-paper-2: #F0F4F2;
  --color-surface: #ffffff;
  --color-surface-2: #F8FAF9;
  --color-ink: #243936;
  --color-ink-2: #526C5D;
  --color-muted: #5F7369;
  --color-rule-strong: #7F9489;
  --color-rule: #E0E8E3;
  --color-primary: #087F72;
  --color-primary-soft: #E9F4EE;
  --color-primary-ink: #ffffff;
  --color-success-strong: #285F48;
  --color-danger-strong: #AC4949;
  --color-danger-soft: #FAECEB;
  --color-disabled-surface: #EDF1EE;
  --color-disabled-ink: #66796E;
  --color-focus: #087F72;
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --text-xs: 12px;
  --text-sm: 14px;
  --text-base: 16px;
  --text-md: 18px;
  --text-xl: 24px;
  --line-tight: 1.2;
  --line-base: 1.5;
  --space-3xs: 4px;
  --space-2xs: 8px;
  --space-xs: 12px;
  --space-sm: 16px;
  --space-md: 20px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-3xl: 48px;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-card: 9px;
  --radius-control: 6px;
  --radius-input: var(--radius-control);
  --radius-pill: 999px;
  --rule-hairline: 1px;
  --z-sticky-nav: 300;
  --touch-target: 44px;
  --bottom-nav-height: 64px;
  --focus-width: 2px;
  --focus-offset: 2px;
  --opacity-disabled: 0.55;

  --paper: var(--color-paper);
  --paper-2: var(--color-paper-2);
  --surface: var(--color-surface);
  --surface-card: var(--color-surface);
  --ink: var(--color-ink);
  --ink-2: var(--color-ink-2);
  --muted: var(--color-muted);
  --rule: var(--color-rule);
  --rule-2: var(--color-rule-2);
  --accent: var(--color-highlight);
  --accent-strong: var(--color-primary);
  --accent-soft: var(--color-primary-soft);
  --accent-ink: var(--color-highlight-ink);
  --signal: var(--color-info);
  --signal-strong: var(--color-info-strong);
  --signal-soft: var(--color-info-soft);
  --success: var(--color-success);
  --success-strong: var(--color-success-strong);
  --success-soft: var(--color-success-soft);
  --warning: var(--color-warning);
  --warning-strong: var(--color-warning-strong);
  --warning-soft: var(--color-warning-soft);
  --danger: var(--color-danger);
  --danger-strong: var(--color-danger-strong);
  --danger-soft: var(--color-danger-soft);
  --on-dark: var(--color-on-dark);
  --on-dark-muted: #b6c8b5;
  --on-dark-soft: #d8e3d5;
  --dark-rule: rgba(255,255,255,.16);
  --dark-rule-strong: rgba(255,255,255,.22);
  --dark-surface-tint: rgba(255,255,255,.08);
  --accent-divider: rgba(23,56,43,.2);
  --accent-muted: rgba(23,56,43,.68);
  --tab-shadow: rgba(23,56,43,.16);
  --warning-on-dark: #f2c477;
  --shadow: var(--shadow-raised);
  --font-display: "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-body: "PingFang SC", "Microsoft YaHei", sans-serif;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
}
