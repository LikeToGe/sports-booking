<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sportsbooking.admin.base.mapper.BookingBalanceHoldMapper">
    <select id="selectByBookingForUpdate" resultType="com.sportsbooking.admin.base.po.BookingBalanceHold">
        SELECT * FROM s_booking_balance_hold WHERE booking_id = #{bookingId} ORDER BY lot_id FOR UPDATE
    </select>
    <select id="selectByBooking" resultType="com.sportsbooking.admin.base.po.BookingBalanceHold">
        SELECT * FROM s_booking_balance_hold WHERE booking_id = #{bookingId} ORDER BY lot_id
    </select>
</mapper>
